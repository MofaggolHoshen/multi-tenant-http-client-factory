{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MultiTenant": {
    "Tenants": [
      {
        "TenantId": "tenant-a",
        "Endpoints": {
          "default": {
            "BaseAddress": "https://api.tenant-a.example.com"
          }
        },
        "DefaultEndpointName": "default",
        "Certificate": {
          "Type": "File",
          "Path": "./certs/tenant-a.pfx",
          "Password": "test-password"
        },
        "DefaultHeaders": {
          "X-Tenant-Version": "v1"
        },
        "Timeout": "00:00:30",
        "HandlerLifetime": "00:02:00"
      },
      {
        "TenantId": "tenant-b",
        "Endpoints": {
          "payments": {
            "BaseAddress": "https://payments.tenant-b.example.com"
          },
          "notifications": {
            "BaseAddress": "https://notifications.tenant-b.example.com"
          }
        },
        "DefaultEndpointName": "payments",
        "Certificate": {
          "Type": "Base64",
          "Data": "MIICljCCAX4CCQCKz0Jq..."
        },
        "DefaultHeaders": {
          "X-Tenant-Version": "v2",
          "X-API-Key": "tenant-b-key"
        },
        "Timeout": "00:00:30",
        "HandlerLifetime": "00:02:00"
      },
      {
        "TenantId": "tenant-c",
        "Endpoints": {
          "default": {
            "BaseAddress": "https://api.tenant-c.example.com"
          }
        },
        "DefaultEndpointName": "default",
        "DefaultHeaders": {
          "X-Tenant-Version": "v1",
          "X-Client-ID": "tenant-c-client"
        },
        "Timeout": "00:00:30",
        "HandlerLifetime": "00:02:00"
      }
    ]
  }
}
